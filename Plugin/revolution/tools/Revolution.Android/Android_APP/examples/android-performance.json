{
  "name": "Android 前台游戏 30 秒帧率采样",
  "steps": [
    {
      "id": "start",
      "target": "game",
      "action": "runtime.performance.begin",
      "arguments": {
        "warmup": 3,
        "seconds": 30,
        "androidDevice": true,
        "releaseOnFinish": true
      }
    },
    {
      "id": "performance",
      "target": "game",
      "action": "runtime.performance.state",
      "until": {
        "path": "/data/finished",
        "equals": true,
        "timeoutSeconds": 55,
        "intervalSeconds": 2
      },
      "expect": [
        {
          "path": "/data/success",
          "equals": true
        },
        {
          "path": "/data/errors",
          "equals": 0
        },
        {
          "path": "/data/unfocusedFrames",
          "equals": 0
        },
        {
          "path": "/data/fps",
          "exists": true
        },
        {
          "path": "/data/p95Ms",
          "exists": true
        },
        {
          "path": "/data/p99Ms",
          "exists": true
        },
        {
          "path": "/data/androidBefore/pid",
          "exists": true
        },
        {
          "path": "/data/androidAfter/pid",
          "exists": true
        }
      ],
      "arguments": {
        "runId": {
          "$ref": "start#/data/runId"
        }
      }
    }
  ],
  "finally": [
    {
      "target": "game",
      "action": "runtime.performance.cancel",
      "arguments": {
        "runId": {
          "$ref": "start#/data/runId"
        }
      }
    }
  ]
}
