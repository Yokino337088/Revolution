<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#006B5D</item>
        <item name="android:windowBackground">#F6F9F8</item>
        <item name="android:statusBarColor">#F6F9F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#13312D</item>
    </style>
    <style name="GroupTitle">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item><item name="android:textStyle">bold</item>
        <item name="android:textColor">#13312D</item><item name="android:layout_marginTop">20dp</item>
    </style>
    <style name="Detail">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item><item name="android:textColor">#385651</item>
        <item name="android:layout_marginTop">6dp</item><item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
