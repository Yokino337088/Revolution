<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/screen" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="14dp" android:paddingBottom="18dp" android:focusableInTouchMode="true"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <FrameLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="116dp"
            android:background="@drawable/hero_surface">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/lab_circuit" android:scaleType="centerCrop"
                android:importantForAccessibility="no" />
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/hero_scrim" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start" android:layout_marginStart="19dp" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/brand" android:fontFamily="sans-serif-medium" android:textStyle="bold"
                    android:textColor="@color/overlay_ink" android:textSize="28sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/lab_name" android:textColor="@color/overlay_muted" android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="13dp" android:background="@drawable/card_surface"
            android:orientation="vertical" android:padding="14dp">
            <TextView style="@style/GroupTitle" android:text="@string/game_title" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center_vertical" tools:ignore="UseCompoundDrawables">
                <ImageView android:id="@+id/game_icon" android:layout_width="41dp" android:layout_height="41dp"
                    android:src="@drawable/ic_bridge" android:importantForAccessibility="no" />
                <TextView android:id="@+id/game" style="@style/Detail" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:textColor="@color/ink" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="10dp"
                style="?android:attr/buttonBarStyle">
                <Button android:id="@+id/pick" style="@style/SecondaryButton" android:text="@string/select_game"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                <Button android:id="@+id/file" style="@style/SecondaryButton" android:text="@string/select_file"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <CheckBox android:id="@+id/isolate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:checked="true" android:text="@string/isolated" />
            <Switch android:id="@+id/overlay_toggle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/show_overlay" android:switchPadding="10dp" android:showText="false" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="13dp" android:background="@drawable/card_surface"
            android:orientation="vertical" android:padding="14dp">
            <TextView style="@style/GroupTitle" android:text="@string/computer" />
            <RadioGroup android:id="@+id/mode" android:orientation="horizontal" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp">
                <RadioButton android:id="@+id/lan" android:text="@string/lan" android:minHeight="48dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <RadioButton android:id="@+id/usb" android:text="@string/usb" android:minHeight="48dp"
                    android:layout_marginStart="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </RadioGroup>
            <EditText android:id="@+id/address" style="@style/AddressField" android:hint="@string/desktop_address"
                android:inputType="textUri" android:imeOptions="actionDone" android:importantForAutofill="no" />
            <TextView android:id="@+id/instructions" style="@style/Detail"
                android:textIsSelectable="true" android:layout_marginTop="7dp" />
            <TextView android:id="@+id/status" style="@style/Detail" android:layout_marginTop="11dp"
                android:textColor="@color/ink" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/pair" style="@style/Detail" android:layout_marginTop="8dp"
                android:fontFamily="monospace" android:textSize="16sp" android:textIsSelectable="true"
                android:visibility="gone" />
            <EditText android:id="@+id/code" style="@style/AddressField" android:layout_marginTop="10dp"
                android:hint="@string/desktop_code" android:inputType="numberPassword" android:maxLength="8"
                android:imeOptions="actionDone" android:importantForAutofill="no" android:saveEnabled="false"
                android:visibility="gone" />

            <Button android:id="@+id/start" style="@style/PrimaryButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" />
            <Button android:id="@+id/stop" style="@style/QuietButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/disconnect" android:visibility="gone" />
            <Button android:id="@+id/agent_history" style="@style/QuietButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/agent_history" />
            <Button android:id="@+id/forget" style="@style/QuietButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/forget_saved" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
