<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:paddingStart="10dp" android:paddingEnd="10dp"
    android:paddingTop="9dp" android:paddingBottom="9dp">
    <TextView android:id="@+id/agent_command" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp" />
    <TextView android:id="@+id/agent_detail" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:layout_marginTop="4dp" android:textSize="12sp" />
</LinearLayout>
